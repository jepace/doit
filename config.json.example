{
  "server": {
    "_note": "When running behind nginx+certbot, set https=true and bind to 127.0.0.1. See nginx snippet below.",
    "host":     "127.0.0.1",
    "port":     8080,
    "https":    true,
    "_https_help": "Set to true when behind a TLS-terminating reverse proxy (nginx+certbot). Enables SESSION_COOKIE_SECURE and trusts X-Forwarded-* headers so real client IPs are used for rate limiting.",
    "base_url": "https://doit.pacehouse.com",
    "_base_url_help": "Used in verification and password-reset emails. Set to your public URL, e.g. https://doit.pacehouse.com",
    "secret":      "",
    "_secret_help": "Flask session secret key — signs login cookies. Leave blank to auto-generate (saved to data/.secret). To set manually: python3 -c \"import secrets; print(secrets.token_hex(32))\"",
    "session_days": 30,
    "_session_days_help": "How long a login session lasts before the cookie expires. Default 30 days.",
    "allow_registration": true,
    "_allow_registration_help": "Whether /register accepts new sign-ups. Defaults to true. Set to false to close sign-ups (e.g. if you want to switch to invite-only) without touching any other code."
  },
  "email": {
    "resend_api_key": "",
    "from_address":  "doit@pacehouse.com"
  },
  "_nginx_example": [
    "server {",
    "    listen 80;",
    "    server_name doit.pacehouse.com;",
    "    return 301 https://$host$request_uri;",
    "}",
    "server {",
    "    listen 443 ssl;",
    "    server_name doit.pacehouse.com;",
    "    ssl_certificate     /etc/letsencrypt/live/doit.pacehouse.com/fullchain.pem;",
    "    ssl_certificate_key /etc/letsencrypt/live/doit.pacehouse.com/privkey.pem;",
    "    location / {",
    "        proxy_pass         http://127.0.0.1:8080;",
    "        proxy_set_header   Host              $host;",
    "        proxy_set_header   X-Real-IP         $remote_addr;",
    "        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;",
    "        proxy_set_header   X-Forwarded-Proto $scheme;",
    "    }",
    "}"
  ]
}
